{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vocs",
  "version": "1.0.2",
  "identifier": "in.hackx.vocs",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "dashboard",
        "url": "index.html",
        "title": "Vocs",
        "width": 904,
        "height": 640,
        "minWidth": 784,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "visible": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 24, "y": 28 },
        "acceptFirstMouse": true
      },
      {
        "label": "sidebar",
        "url": "sidebar.html",
        "width": 64,
        "height": 260,
        "resizable": false,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "pill",
        "url": "pill.html",
        "width": 176,
        "height": 36,
        "resizable": false,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "focus": false,
        "acceptFirstMouse": false
      },
      {
        "label": "caption",
        "url": "caption.html",
        "width": 560,
        "height": 168,
        "resizable": false,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "acceptFirstMouse": false
      },
      {
        "label": "onboarding",
        "url": "onboarding.html",
        "title": "Welcome to Vocs",
        "width": 680,
        "height": 560,
        "resizable": false,
        "center": true,
        "visible": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "scratchpad",
        "url": "scratchpad.html",
        "title": "Vocs scratchpad",
        "width": 560,
        "height": 420,
        "minWidth": 420,
        "minHeight": 300,
        "resizable": true,
        "center": true,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0NDIwOUFEQjlFRDE0OTUKUldTVkZPMjVyUWxDcE1NV2FtT0V6SE54YUdMQUtvbURkT2NmM0RUSS94Ui9IemZacnMyRWt6V2YK",
      "endpoints": [
        "https://github.com/HackX-IN/vocs/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "createUpdaterArtifacts": false,
    "category": "Productivity",
    "shortDescription": "Local-first speech to text.",
    "longDescription": "Press a hotkey, talk, press it again — your words are pasted where you were typing. Runs entirely on your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    }
  }
}
